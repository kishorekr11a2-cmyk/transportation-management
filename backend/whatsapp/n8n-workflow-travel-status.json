      },
      {
        "parameters": {
          "jsCode": "// Retrieve payload from webhook body\nconst body = $input.first().json.body || $input.first().json;\nlet rawUsers = [];\n\nif (Array.isArray(body?.users) && body.users.length > 0) {\n  rawUsers = body.users;\n} else if (body?.phoneNumber) {\n  rawUsers = [body];\n}\n\n// Deduplicate phone numbers within this run\nconst seen = new Set();\nconst items = [];\n\nfor (const u of rawUsers) {\n  if (!u || !u.phoneNumber) continue;\n  const digits = String(u.phoneNumber).replace(/\\D/g, '');\n  if (!digits || digits.length < 10 || seen.has(digits)) continue;\n  seen.add(digits);\n\n  const phone = String(u.phoneNumber).trim();\n  const msg = String(u.message || '').trim();\n\n  items.push({\n    json: {\n      body: {\n        phoneNumber: phone,\n        message: msg,\n        userId: u.userId || '',\n        name: u.name || ''\n      },\n      phoneNumber: phone,\n      message: msg,\n      userId: u.userId || '',\n      name: u.name || ''\n    }\n  });\n}\n\nreturn items;"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
